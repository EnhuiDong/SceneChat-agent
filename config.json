{
  "llm": {
    "request_timeout_seconds": 180,
    "max_retries": 1,
    "json_mode": "auto",
    "token_limit_parameter": "max_tokens",
    "enable_thinking": false
  },
  "embedding": {
    "batch_size": 20,
    "request_timeout_seconds": 180,
    "max_retries": 1
  },
  "scenario": {
    "json_repair_retries": 2,
    "semantic_repair_retries": 2,
    "semantic_total_attempts": 6,
    "transport_retries": 1,
    "step_timeout_seconds": 240,
    "build_timeout_seconds": 600,
    "request_timeout_seconds": 120,
    "max_requests_per_step": 4,
    "repair_max_tokens": 4096
  },
  "simulation": {
    "input_budget_bytes": 96000,
    "context_section_bytes": 6000,
    "parse_retries": 1,
    "quality_retries": 1,
    "transport_retries": 1,
    "max_requests_per_operation": 5,
    "operation_timeout_seconds": 180,
    "consecutive_fallback_limit": 3,
    "fallback_window_size": 12,
    "fallback_window_limit": 6,
    "intent_max_tokens": 900,
    "narration_max_tokens": 480,
    "beat_verification_max_tokens": 700,
    "beat_verification_timeout_seconds": 45,
    "max_turns": 120
  },
  "storage": {
    "checkpoint_retention": 40,
    "database_path": "data/scenechat.db"
  },
  "server": {
    "cors_origins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  }
}
